{
  "name": "forja-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA de Forja (React + TypeScript + Vite).",
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api/schema.d.ts",
    "gen:mocks": "node scripts/generate-msw-handlers.js",
    "gen": "npm run gen:api && npm run gen:mocks",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "prelint": "npm run gen",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "pretest": "npm run gen",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "i18next": "^24.2.3",
    "msw": "^2.15.0",
    "openapi-fetch": "^0.13.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.7",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}