# =============================================================================
# Forja · configuración por variables de entorno (MASTER_PROMPT §12.3)
# Copia este fichero a `.env` y ajústalo. `make bootstrap` rellena los secretos vacíos
# (SECRET_KEY, POSTGRES_PASSWORD y la contraseña de DATABASE_URL).
# La API valida cada variable al arrancar (backend/app/core/config.py): un valor inválido
# detiene el arranque con un mensaje claro.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Credenciales del contenedor `db` (postgres:16-alpine). Sin puerto publicado.
POSTGRES_DB=forja
POSTGRES_USER=forja
# Obligatoria. `make bootstrap` genera una aleatoria de 32 bytes si está vacía.
POSTGRES_PASSWORD=
# URL que usa la API. Driver obligatorio: postgresql+asyncpg.
# Formato: postgresql+asyncpg://<usuario>:<contraseña>@db:5432/<base de datos>
DATABASE_URL=

# --- Seguridad ---------------------------------------------------------------
# Clave de la aplicación (>= 32 caracteres). Firma y deriva hashes (IP en logs).
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Días de validez deslizante de la sesión (cookie __Host-forja_session). 1-365.
SESSION_TTL_DAYS=30

# --- URL pública -------------------------------------------------------------
# URL con la que los usuarios acceden a Forja (la de tu reverse proxy con TLS).
PUBLIC_BASE_URL=https://forja.example.org
# Puerto del contenedor `web` (nginx de Forja) publicado en el host del LXC.
WEB_PORT=8080

# --- Medios (© Gym visual, ver ADR 0004) --------------------------------------
# Directorio de medios dentro de los contenedores (volumen `media`).
MEDIA_ROOT=/var/lib/forja/media
# true (recomendado): los GIF y miniaturas solo se sirven a usuarios autenticados.
# Si lo pones a false y expones Forja públicamente, revisa antes los términos de Gym visual:
# https://gymvisual.com/content/3-terms-and-conditions-of-use
MEDIA_REQUIRE_AUTH=true

# --- Dataset de ejercicios -------------------------------------------------------
DATASET_REPO=https://github.com/hasaneyldrm/exercises-dataset
# Commit fijado (2026-07-16). Cambiarlo exige volver a ejecutar la ingesta y revisar
# docs/dataset-analysis.md.
DATASET_COMMIT=7455efae41b330c265e7cd4b78dfa848e7ce5ebd

# --- Funcionalidades -----------------------------------------------------------
# Registro abierto. Por defecto cerrado: `make bootstrap` crea el administrador.
# El administrador puede cambiarlo después desde Admin (prevalece sobre este valor).
REGISTRATION_OPEN=false
# Módulo de dieta disponible globalmente (cada usuario lo activa en su perfil).
DIET_FEATURE_ENABLED=true
# Idioma por defecto de la interfaz: es | en
DEFAULT_LOCALE=es

# --- Operación -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL (logs JSON a stdout, sin datos personales)
LOG_LEVEL=INFO
# Procesos de Gunicorn (1-32). Recomendado: 2 en un LXC de 2 vCPU.
GUNICORN_WORKERS=2
# Expone /metrics en formato Prometheus (solo red interna).
METRICS_ENABLED=false
